# Umgebungsvariablen des Dienstes (auf dem Server: /etc/usv-monitor/env)

# Signatur der Anmelde-Sitzungen, zufällig und geheim
USV_SECRET_KEY=

# Benutzer (JSON). Fehlt die Datei, wird beim ersten Start ein Admin mit Einmal-Passwort angelegt:
# initial-admin-password.txt im selben Ordner
USV_USERS_FILE=/etc/usv-monitor/users.json

# Nur für die Entwicklung: feste Demo-Benutzer mit bekannten Passwörtern
# USV_DEMO_USERS=true

# Schlüssel für gespeicherte Passwörter und Zertifikate der Zielrechner (wird beim ersten Start erzeugt)
USV_SECRET_KEY_FILE=/etc/usv-monitor/secret.key

# Ablage der OPC-UA-Zertifikate
USV_PKI_DIR=/etc/usv-monitor/pki

# HTTPS: eigenes Zertifikat (z. B. interne CA). Ohne Angabe entsteht ein selbstsigniertes in USV_TLS_DIR.
USV_TLS_DIR=/etc/usv-monitor/tls
# USV_TLS_CERT=/etc/usv-monitor/tls/eigenes.crt
# USV_TLS_KEY=/etc/usv-monitor/tls/eigenes.key

# Messwerte im RAM sammeln und alle n Sekunden gemeinsam schreiben (schont die SD-Karte), 0 = sofort. Standard: 900
# USV_DB_FLUSH_SECONDS=900

# Messwerte in voller Auflösung so viele Monate behalten, danach Stundenwerte, 0 = nie verdichten. Standard: 24
# USV_DB_RETENTION_MONTHS=24

# Nur für die Entwicklung: Dashboard ohne HTTPS
# USV_ALLOW_HTTP=true

# Erzwingt den Testmodus; in der Oberfläche lässt er sich dann nicht ausschalten
# UPS_DRY_RUN=true

PYTHONUNBUFFERED=1
